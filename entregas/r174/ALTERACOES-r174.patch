+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import vm from 'node:vm';
+
+const source = fs.readFileSync(new URL('../dist/v77-experience.js', import.meta.url), 'utf8');
+function section(start, end) {
+  const a = source.indexOf(start), b = source.indexOf(end, a);
+  assert(a >= 0 && b > a, `Trecho ausente: ${start}`);
+  return source.slice(a, b);
+}
+const code = [
+  section('  function answerOptionText(', '  function applyReviewedAnswerKey('),
+  section('  function answerKeyStatus(', '  function answerKeyDetails('),
+  section('  function questionMatchesErrorPool(', '  function isQuestionFavorited('),
+  section('  function startErrorReinforcementBattle(){', '  // 2B. Resolução'),
+  section('  function launchSingleErrorRetryByKey(', '  window.launchSingleErrorRetryByKey ='),
+].join('\n');
+const normalize = value => String(value || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
+const original = {campaignId:'portal-a',subject:'Língua Portuguesa',topic:'Crase',question:'Assinale a alternativa correta sobre o uso da crase.',options:['Opção incorreta.','Opção correta.','Outra opção incorreta.'],correct_index:1,correctAnswer:'Opção correta.',explanation:'Explicação preservada.'};
+const bankQuestion = extra => ({subject:original.subject,topic:original.topic,statement:original.question,options:[...original.options],correct_index:1,origin:'oficial',...extra});
+
+function env(errors, bank = [], preparedInvalid = false) {
+  const toasts = [], theory = [];
+  const ui = {'#questionDialogTitle':{},'#questionDialog':{showModal(){ui.opened++;}},opened:0,shown:0};
+  const ctx = {
+    window:{openTheoryForSubjectAndTopic:(...args)=>theory.push(args)},
+    document:{querySelector:selector=>ui[selector]},
+    q:selector=>ui[selector],
+    state:{activeCampaignId:'portal-a',errors}, ALL_QUESTIONS:bank, activeQuestions:null,
+    toast:text=>toasts.push(text),
+    activeCampaignErrors:()=>Object.entries(errors).filter(([,e])=>!e.campaignId||e.campaignId==='portal-a'),
+    deduplicateAndSanitizeErrorNotebook(){},
+    topicKey:normalize,
+    resolveStrictQuestionDiscipline:item=>typeof item==='object'?item.subject:original.subject,
+    isQuestionDisciplineEligible:(item, subject='all')=>Boolean(item&&!item.needs_review&&(subject==='all'||normalize(item.subject)===normalize(subject))),
+    progressiveQuestions:(items,count)=>items.slice(0,count),
+    prepareQuestion:item=>({...item,correct_index:preparedInvalid?null:item.correct_index}),
+    prepareQuestionConsistent:item=>({...item,correct_index:preparedInvalid?null:item.correct_index}),
+    showQuestion:()=>ui.shown++,
+    buildSubjectAppropriateDistractors(){throw new Error('Não deve fabricar alternativas.');},
+    startSubjectTargetedFix(){throw new Error('Não deve substituir erro incompleto por treino aleatório.');},
+  };
+  ctx.window.showQuestion=ctx.showQuestion;
+  vm.createContext(ctx);vm.runInContext(code,ctx);
+  return {ctx,toasts,theory,ui};
+}
+
+// Um gabarito textual solto não permite reconstruir alternativas nem presumir A.
+{
+  const legacy={...original};delete legacy.options;delete legacy.correct_index;
+  const errors={old:legacy}, before=JSON.stringify(errors);
+  const {ctx,toasts,theory,ui}=env(errors);
+  ctx.startErrorReinforcementBattle();
+  assert.equal(ctx.activeQuestions,null);assert.equal(ui.opened,0);
+  assert(toasts.some(text=>text.includes('Ler Teoria')));
+  ctx.launchSingleErrorRetryByKey('old');
+  assert.equal(ctx.activeQuestions,null);assert.equal(ui.opened,0);
+  assert.equal(theory[0][0],original.subject);assert.equal(theory[0][1],original.topic);
+  assert.equal(JSON.stringify(errors),before,'Revisão teórica preserva o registro e não concede acertos.');
+}
+
+// Restaura somente alternativas e índice realmente preservados, sem exigir correctAnswer textual.
+{
+  const stored={...original,key_source:'manual_revisado',answer_key_validation:'revisado',key_reference:'Conferência própria'};
+  delete stored.correctAnswer;
+  const {ctx,ui}=env({ok:stored});
+  ctx.startErrorReinforcementBattle();
+  assert.equal(ui.opened,1);
+  let restored=ctx.activeQuestions.questions[0];
+  assert.deepEqual([...restored.options],original.options);assert.equal(restored.correct_index,1);
+  assert.equal(restored.key_source,'manual_revisado');assert.equal(restored._errorNotebookKey,'ok');
+  ctx.launchSingleErrorRetryByKey('ok');
+  restored=ctx.activeQuestions.questions[0];
+  assert.equal(restored.origin,'autoral','Histórico sem origem não deve virar questão oficial ou adaptada do PDF.');
+  assert.equal(restored.key_reference,'Conferência própria');assert.equal(restored.correct_index,1);
+}
+
+for (const change of [
+  ...[null,undefined,'',true,false,-1,3,'abc',{}].map(correct_index=>({correct_index})),
+  {options:['','Opção correta.']},{options:['Única alternativa.']},
+  {answer_unknown:true},{annulled:true},{anulada:true},{needs_review:true},
+  {key_source:'ia_sugerido',answer_key_validation:'pendente'},
+]) {
+  const {ctx,ui}=env({bad:{...original,...change}});
+  ctx.startErrorReinforcementBattle();ctx.launchSingleErrorRetryByKey('bad');
+  assert.equal(ctx.activeQuestions,null,JSON.stringify(change));
+  assert.equal(ui.opened,0);
+}
+
+// Questão original encontrada no banco pode recuperar um registro legado incompleto.
+{
+  const legacy={...original};delete legacy.options;delete legacy.correct_index;
+  const q=bankQuestion({key_source:'oficial_definitivo'});
+  const {ctx}=env({old:legacy},[q]);
+  ctx.launchSingleErrorRetryByKey('old');
+  assert.equal(ctx.activeQuestions.questions[0].origin,'oficial');
+  assert.equal(ctx.activeQuestions.questions[0].key_source,'oficial_definitivo');
+  assert.equal(ctx.activeQuestions.questions[0]._errorNotebookKey,'old');
+}
+
+// Questões extras exigem mesma disciplina, alternativas completas e gabarito utilizável.
+{
+  const bank=[
+    bankQuestion({statement:'Questão de reforço da mesma disciplina.'}),
+    bankQuestion({statement:'Questão de outra disciplina.',subject:'Direito Penal'}),
+    bankQuestion({statement:'Questão sem gabarito.',correct_index:null}),
+    bankQuestion({statement:'Questão com sugestão da IA.',key_source:'ia_sugerido'}),
+    bankQuestion({statement:'Questão anulada.',annulled:true}),
+    bankQuestion({statement:'Questão de outro conteúdo.',topic:'Análise sintática'}),
+  ];
+  const {ctx}=env({ok:{...original}},bank);
+  ctx.launchSingleErrorRetryByKey('ok');
+  assert.equal(ctx.activeQuestions.questions.length,2);
+  assert(ctx.activeQuestions.questions.every(item=>item.subject===original.subject));
+  const aggregate=env({ok:{...original}},bank);aggregate.ctx.startErrorReinforcementBattle();
+  assert.equal(aggregate.ctx.activeQuestions.questions.length,1);
+}
+{
+  const {ctx,ui}=env({other:{...original,campaignId:'portal-b'}});
+  ctx.launchSingleErrorRetryByKey('other');assert.equal(ui.opened,0);
+}
+{
+  const {ctx,ui}=env({ok:{...original}},[],true);
+  ctx.startErrorReinforcementBattle();ctx.launchSingleErrorRetryByKey('ok');
+  assert.equal(ui.opened,0,'Preparação inválida também deve impedir o treino.');
+}
+console.log('OK r174: Caderno de Erros não fabrica alternativas/gabaritos, preserva revisão teórica e só treina questões completas na disciplina e portal corretos.');
+
+// O diagnóstico por disciplina também recebia erros legados e fabricava opções.
+for (const complete of [false, true]) {
+  const stored = {...original};
+  if (!complete) {delete stored.options; delete stored.correct_index;}
+  const {ctx, ui, theory} = env({targeted: stored});
+  ctx.canonicalSubjectName = value => value;
+  ctx.sanitizeAllQuestionsAndErrorsSubjects = () => {};
+  ctx.questionFingerprint = item => JSON.stringify([item.subject, item.topic, item.statement]);
+  vm.runInContext(section('  function startSubjectTargetedFix(', '  window.startSubjectTargetedFix='), ctx);
+  ctx.startSubjectTargetedFix(original.subject, true);
+  if (complete) {
+    assert.equal(ui.opened, 1);
+    assert.deepEqual([...ctx.activeQuestions.questions[0].options], original.options);
+    assert.equal(ctx.activeQuestions.questions[0].correct_index, 1);
+  } else {
+    assert.equal(ui.opened, 0);
+    assert.equal(ctx.activeQuestions, null);
+    assert.equal(theory[0][0], original.subject);
+  }
+}
+console.log('OK r174: diagnóstico por disciplina também usa somente alternativas originais e direciona registro incompleto à teoria.');
diff --git a/scripts/test-r174-local-cache.mjs b/scripts/test-r174-local-cache.mjs
new file mode 100644
index 0000000..bd447ea
--- /dev/null
+++ b/scripts/test-r174-local-cache.mjs
@@ -0,0 +1,93 @@
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import vm from 'node:vm';
+
+const html = fs.readFileSync(new URL('../dist/index.html', import.meta.url), 'utf8');
+const source = html.slice(html.indexOf('async function persistToLocalDatabase('), html.indexOf('window.persistToLocalDatabase='));
+const native = {subject: 'Português', topic: 'Crase', statement: 'Questão nativa de crase', options: ['a', 'b'], correct_index: 1};
+const imported = {...native, statement: 'Questão importada de regência', topic: 'Regência', key_source: 'ia_sugerido', answer_key_validation: 'pendente'};
+function setup({readDelayed = false, openDelayed = false, failWrite = false, cacheUser = 'user-a', cacheCampaign = 'portal-a'} = {}) {
+  let releaseRead, releaseOpen, request, written = null, badges = 0, renders = 0;
+  const cache = {userId: cacheUser, campaignId: cacheCampaign, resetEpoch: 0,
+    questions: [{...native, explanation: 'cache antigo'}, imported, {...imported}],
+    summaries: [{id: 'custom-summary', title: 'Material importado', category: 'Português'}],
+    flashcards: [['Português', 'Pergunta longa o suficiente', 'Resposta longa o suficiente']]};
+  const db = {transaction: (_table, mode) => {
+    const tx = {objectStore: () => ({
+      get: () => {
+        request = {};
+        releaseRead = () => {request.result = cache; request.onsuccess();};
+        if (!readDelayed) queueMicrotask(releaseRead);
+        return request;
+      },
+      put: (value, key) => {
+        written = {value, key};
+        queueMicrotask(() => failWrite ? tx.onabort() : tx.oncomplete());
+      },
+    })};
+    return tx;
+  }};
+  const context = {
+    state: {activeCampaignId: 'portal-a', customCampaign: {missions: []}}, cloudSession: {user: {id: 'user-a'}},
+    ALL_QUESTIONS: [{...native, explanation: 'versão atual'}],
+    ALL_SUMMARIES: [{id: 'manual-local', title: 'Guia da plataforma'}], ALL_FLASHCARDS: [], LEARNING_SUBJECTS: [],
+    cloudDocuments: [], cloudEssays: [],
+    localCachePortalKey: id => 'user-a:' + id,
+    openLocalStudyCacheDB: () => openDelayed ? new Promise(resolve => {releaseOpen = () => resolve(db);}) : Promise.resolve(db),
+    localStorage: {setItem() {}},
+    questionFingerprint: item => JSON.stringify([item.subject, item.topic, item.statement]),
+    isValidPedagogicalQuestion: item => !!item?.statement,
+    isValidFlashcardItem: (question, answer) => !!question && !!answer,
+    sanitizeSummaryObject: item => item,
+    isEditalDocumentOrTitle: () => false, isContaminatedNonEditalMission: () => false,
+    normalizeAndOrderEditalMissions: items => items,
+    activeCampaign: () => ({name: 'Portal A'}),
+    computeValidLearningSubjects: () => ['Português'],
+    $: () => null, document: {querySelector: () => null},
+    renderViewById: () => {renders++;},
+    window: {markViewsDirty() {}, updateLocalDbBadgeUI: () => {badges++;}},
+  };
+  vm.createContext(context);
+  vm.runInContext(source, context);
+  return {context, read: () => releaseRead(), open: () => releaseOpen(), cache,
+    get written() {return written;}, get badges() {return badges;}, get renders() {return renders;}};
+}
+
+const merged = setup();
+assert.equal(await merged.context.hydrateFromLocalDatabase(), true);
+assert.equal(merged.context.ALL_QUESTIONS.length, 2, 'Banco nativo inicializado não pode ocultar questões do cache');
+assert.equal(merged.context.ALL_QUESTIONS[0].explanation, 'versão atual', 'Cache não substitui correção mais recente em memória');
+assert.equal(merged.context.ALL_QUESTIONS[1].key_source, 'ia_sugerido', 'Preserve a origem de confiança do gabarito');
+assert.equal(merged.context.ALL_SUMMARIES.length, 2, 'Manuais e material importado devem coexistir');
+assert.equal(merged.context.ALL_FLASHCARDS.length, 1);
+await merged.context.hydrateFromLocalDatabase();
+assert.equal(merged.context.ALL_QUESTIONS.length, 2, 'Reidratar novamente não duplica o banco');
+
+for (const change of [ctx => {ctx.state.activeCampaignId = 'portal-b';}, ctx => {ctx.cloudSession.user.id = 'user-b';}, ctx => {ctx.state._resetEpoch = 1;}]) {
+  const delayed = setup({readDelayed: true});
+  const result = delayed.context.hydrateFromLocalDatabase();
+  await new Promise(resolve => setImmediate(resolve));
+  change(delayed.context);
+  delayed.read();
+  assert.equal(await result, false, 'Troca de usuário/portal/reset durante leitura cancela aplicação do cache');
+  assert.equal(delayed.context.ALL_QUESTIONS.length, 1);
+  assert.equal(delayed.renders, 0);
+}
+assert.equal(await setup({cacheUser: 'another-user'}).context.hydrateFromLocalDatabase(), false);
+assert.equal(await setup({cacheCampaign: 'another-portal'}).context.hydrateFromLocalDatabase(), false);
+
+const saved = setup();
+assert.equal(await saved.context.persistToLocalDatabase(), true);
+assert.equal(saved.written.key, 'user-a:portal-a');
+assert.equal(saved.badges, 1);
+const failed = setup({failWrite: true});
+assert.equal(await failed.context.persistToLocalDatabase(), false);
+assert.equal(failed.badges, 0, 'Transação abortada não anuncia banco salvo');
+const switching = setup({openDelayed: true});
+const save = switching.context.persistToLocalDatabase();
+switching.context.state.activeCampaignId = 'portal-b';
+switching.context.ALL_QUESTIONS = [{...imported, statement: 'Conteúdo exclusivo do portal B'}];
+switching.open();
+assert.equal(await save, false);
+assert.equal(switching.written, null, 'Não grave conteúdo do novo portal na chave do portal antigo');
+console.log('OK r174: banco nativo e cache importado coexistem; reidratação sem duplicatas; usuário/portal/reset e transação abortada isolados.');
diff --git a/scripts/test-r174-option-telemetry.mjs b/scripts/test-r174-option-telemetry.mjs
new file mode 100644
index 0000000..a9cea12
--- /dev/null
+++ b/scripts/test-r174-option-telemetry.mjs
@@ -0,0 +1,56 @@
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import vm from 'node:vm';
+
+const source = fs.readFileSync(new URL('../dist/v77-experience.js', import.meta.url), 'utf8');
+const start = source.indexOf('  function computeQuestionOptionChoiceStats(item, chosenIndex) {');
+const end = source.indexOf('  window.computeQuestionOptionChoiceStats = computeQuestionOptionChoiceStats;', start);
+assert(start >= 0 && end > start);
+const context = {
+  state: {activeCampaignId:'portal-a', optionChoiceTelemetry:{fixture:{0:4,1:3}}},
+  questionFingerprint: item => item.id || 'fixture',
+  answerOptionText: value => String(value ?? '').normalize('NFC').replace(/\s+/g,' ').trim().replace(/^[A-E]\)\s+/,''),
+  answerKeyStatus: item => item.answer_unknown || item.key_source === 'ia_sugerido' ? 'sem_gabarito' : item.annulled ? 'anulada' : 'revisado',
+};
+vm.createContext(context);
+vm.runInContext(source.slice(start, end), context);
+const stats = (item, choice) => context.computeQuestionOptionChoiceStats(item, choice);
+const q = {id:'fixture',statement:'Qual opção corresponde ao resultado?',options:['A) Resposta certa','B) Distrator errado'],correct_index:0};
+const plain = value => JSON.parse(JSON.stringify(value));
+
+const legacy = stats(q);
+assert.deepEqual(plain(legacy.counts),[0,0], 'Índices antigos não identificam alternativas após embaralhamento');
+assert.equal(legacy.totalSamples,0);
+assert.equal(legacy.legacySamples,7, 'Histórico legado deve permanecer reconhecido e preservado');
+assert.deepEqual(context.state.optionChoiceTelemetry.fixture,{0:4,1:3});
+
+assert.deepEqual(plain(stats(q,1).counts),[0,1]);
+const shuffled = {...q,options:['A) Distrator errado','B) Resposta certa'],correct_index:1};
+const afterShuffle = stats(shuffled);
+assert.deepEqual(plain(afterShuffle.counts),[1,0], 'A escolha acompanha o texto, não a antiga letra B');
+assert.equal(afterShuffle.trapIndex,0);
+assert.equal(afterShuffle.correctIndex,1);
+assert.deepEqual(plain(stats(shuffled,1).counts),[1,1]);
+assert.deepEqual(plain(stats(q).counts),[1,1]);
+
+context.state.activeCampaignId='portal-b';
+assert.equal(stats(q).totalSamples,0, 'Um portal não recebe estatísticas do outro');
+stats(q,0);
+context.state.activeCampaignId='portal-a';
+assert.equal(stats(q).totalSamples,2);
+assert.equal(stats({...q,options:['Resposta certa','Novo distrator']}).totalSamples,0, 'Editar alternativas inicia uma versão compatível nova');
+
+for (const change of [{key_source:'ia_sugerido'},{answer_unknown:true},{annulled:true},{correct_index:null},{correct_index:true},{correct_index:-1},{correct_index:7}]) {
+  const before=stats(q).totalSamples;
+  stats({...q,...change},0);
+  assert.equal(stats(q).totalSamples,before,`Gabarito inválido ou não validado não grava telemetria: ${JSON.stringify(change)}`);
+}
+stats(q,-1);stats(q,2);stats(q,'0');
+assert.equal(stats(q).totalSamples,2);
+assert.equal(stats({id:'empty',options:[],correct_index:null}).correctIndex,-1);
+assert.deepEqual(plain(stats({id:'empty',options:[],correct_index:null}).counts),[]);
+assert.equal(stats({id:'duplicated',options:['Mesmo texto','Mesmo texto'],correct_index:0},0).totalSamples,0, 'Alternativas de conteúdo duplicado não têm identidade inequívoca');
+const adversarial={id:'prototype',options:['__proto__','constructor'],correct_index:1};
+assert.equal(stats(adversarial,0).totalSamples,1);
+assert.equal({}.polluted,undefined);
+console.log('OK r174: histórico por conteúdo acompanha embaralhamento, isola portais/versões, preserva legado sem reinterpretá-lo e exclui gabaritos pendentes.');
diff --git a/scripts/test-r174-session-performance.mjs b/scripts/test-r174-session-performance.mjs
new file mode 100644
index 0000000..a98cde1
--- /dev/null
+++ b/scripts/test-r174-session-performance.mjs
@@ -0,0 +1,230 @@
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import vm from 'node:vm';
+
+function memoryStorage() {
+  const values = new Map();
+  return {
+    get length() { return values.size; },
+    key(index) { return [...values.keys()][index] ?? null; },
+    getItem(key) { return values.get(key) ?? null; },
+    setItem(key, value) { values.set(key, String(value)); },
+    removeItem(key) { values.delete(key); }
+  };
+}
+const storeContext = { window: {} };
+vm.createContext(storeContext);
+vm.runInContext(fs.readFileSync(new URL('../dist/question-session-store.js', import.meta.url), 'utf8'), storeContext);
+const { createStore, scopeKey } = storeContext.window.JornadaQuestionSessions;
+const storage = memoryStorage(), firstTab = memoryStorage();
+let now = 1800000000000;
+const scope = { userId: 'user-a', campaignId: 'portal-a', resetEpoch: 0 };
+const question = { statement: 'Qual o resultado de 2 + 2?', subject: 'Matemática', options: ['3', '4'], correct_index: 1, _userAnswered: true, _userChosenIndex: 1 };
+const snapshot = { title: 'Treino de Matemática', battle: { questions: [question, { ...question, _userAnswered: false }], current: 1, correct: 1, answered: false } };
+const first = createStore({ storage, fallbackStorage: firstTab, now: () => now });
+assert.equal(first.save(scope, snapshot), 'local');
+// Closing the first tab loses its sessionStorage. The local snapshot still resumes unchanged.
+const reopened = createStore({ storage, fallbackStorage: memoryStorage(), now: () => now });
+assert.equal(reopened.read(scope).battle.current, 1);
+assert.deepEqual(JSON.parse(JSON.stringify(reopened.read(scope).battle.questions[0])), question);
+assert.equal(reopened.read({ ...scope, userId: 'user-b' }), null);
+assert.equal(reopened.read({ ...scope, campaignId: 'portal-b' }), null);
+assert.equal(reopened.read({ ...scope, resetEpoch: 1 }), null, 'perfil redefinido não pode retomar treino antigo');
+first.save(scope, snapshot);
+now += 7 * 86400000 + 1;
+assert.equal(reopened.read(scope), null, 'treino expirado deve desaparecer');
+storage.setItem(scopeKey(scope), '{invalid-json');
+assert.equal(reopened.read(scope), null);
+assert.equal(storage.getItem(scopeKey(scope)), null);
+const blocked = { ...memoryStorage(), setItem() { throw new Error('QuotaExceededError'); } };
+const tab = memoryStorage();
+const fallback = createStore({ storage: blocked, fallbackStorage: tab, now: () => now });
+assert.equal(fallback.save(scope, snapshot), 'session');
+assert.equal(fallback.read(scope).battle.correct, 1);
+assert.equal(createStore({ storage: blocked, fallbackStorage: blocked, now: () => now }).save(scope, snapshot), null);
+assert.equal(first.save(scope, { ...snapshot, battle: { ...snapshot.battle, current: 9 } }), null);
+assert.equal(first.save(scope, { ...snapshot, battle: { ...snapshot.battle, questions: [{ statement: 'Inválida', options: [] }] } }), null);
+first.save(scope, snapshot);
+first.save({ ...scope, campaignId: 'portal-b' }, snapshot);
+first.clear(scope);
+assert.equal(first.read(scope), null);
+assert(first.read({ ...scope, campaignId: 'portal-b' }));
+storage.setItem('other-app-data', 'preserve');
+first.clearAll();
+assert.equal(first.read({ ...scope, campaignId: 'portal-b' }), null);
+assert.equal(storage.getItem('other-app-data'), 'preserve');
+
+const source = fs.readFileSync(new URL('../dist/v77-experience.js', import.meta.url), 'utf8');
+function section(start, end) {
+  const a = source.indexOf(start), b = source.indexOf(end, a);
+  assert(a >= 0 && b > a, `bloco ausente: ${start}`);
+  return source.slice(a, b);
+}
+// Rendering the filters performs one pass and never builds the catalogue or charts.
+const calls = [];
+const filters = {
+  renderQuestionFilters: () => calls.push('filters'),
+  populateTopicFilter: () => calls.push('topics'),
+  updateQuestionPool: () => calls.push('pool'),
+  renderExamBankHub: () => calls.push('catalogue'),
+  renderPerformanceChart: () => calls.push('charts')
+};
+vm.createContext(filters);
+vm.runInContext(section('  const baseRenderQuestionFilters=', '  // 11. Painel TAF'), filters);
+filters.renderQuestionFilters();
+assert.deepEqual(calls, ['filters', 'topics', 'pool']);
+
+// Secondary work starts after paint, splits charts/catalogue, and cancels stale portal/view jobs.
+let active = true;
+const frames = [], tasks = [], renders = [];
+const deferred = {
+  window: { requestAnimationFrame: fn => frames.push(fn) },
+  setTimeout: fn => tasks.push(fn),
+  state: { activeCampaignId: 'portal-a' },
+  q: () => ({ classList: { contains: () => active } }),
+  renderPerformanceChart: () => renders.push('charts'),
+  renderExamBankHub: () => renders.push('catalogue')
+};
+vm.createContext(deferred);
+vm.runInContext(section('  let questionReportExtrasGeneration=', '  const baseRenderReport='), deferred);
+function runFrame() { frames.splice(0).forEach(fn => fn()); tasks.splice(0).forEach(fn => fn()); }
+deferred.scheduleQuestionReportExtras();
+assert.deepEqual(renders, []);
+runFrame(); assert.deepEqual(renders, ['charts']);
+runFrame(); assert.deepEqual(renders, ['charts', 'catalogue']);
+renders.length = 0;
+deferred.scheduleQuestionReportExtras(); deferred.scheduleQuestionReportExtras();
+runFrame(); runFrame();
+assert.deepEqual(renders, ['charts', 'catalogue'], 'renderizações repetidas devem cancelar o trabalho anterior');
+renders.length = 0;
+deferred.scheduleQuestionReportExtras(); deferred.state.activeCampaignId = 'portal-b';
+runFrame(); runFrame(); assert.deepEqual(renders, []);
+deferred.scheduleQuestionReportExtras(); active = false;
+runFrame(); runFrame(); assert.deepEqual(renders, []);
+
+// Reviewing an already answered item cannot score again or replace the original choice.
+let scored = 0, saved = 0;
+const answeredItem = { statement: 'Questão', options: ['A', 'B'] };
+const hooks = {
+  activeQuestions: { answered: false, correct: 0, current: 0 },
+  window: {}, document: { querySelector: () => null },
+  saveActiveQuestionSession: () => saved++
+};
+hooks.window.answerQuestion = () => { scored++; hooks.activeQuestions.answered = true; hooks.activeQuestions.correct++; };
+hooks.window.skipQuestionBlank = () => { hooks.activeQuestions.answered = true; };
+vm.createContext(hooks);
+vm.runInContext(section('  const origAnswerQ = window.answerQuestion;', '  const origNextQ = window.nextQuestion;'), hooks);
+hooks.window.answerQuestion({ dataset: { questionIndex: '1' } }, answeredItem);
+hooks.window.answerQuestion({ dataset: { questionIndex: '0' } }, answeredItem);
+assert.equal(scored, 1); assert.equal(saved, 1);
+assert.equal(answeredItem._userChosenIndex, 1);
+hooks.activeQuestions.answered = false;
+hooks.window.answerQuestion({ dataset: { questionIndex: '0' } }, answeredItem);
+assert.equal(scored, 1);
+
+// Existing missions cannot turn a new/unprocessed edital into a completed analysis.
+const html = fs.readFileSync(new URL('../dist/index.html', import.meta.url), 'utf8');
+const documents = [
+  { id: 'pending', document_type: 'edital', processing_status: 'pending', user_id: 'user-a', title: 'Novo edital' },
+  { id: 'processing', document_type: 'edital', processing_status: 'processing', user_id: 'user-a', title: 'Em análise', metadata: { analysis_progress: { updated_at: new Date().toISOString() } } },
+  { id: 'ready', document_type: 'edital', processing_status: 'ready', user_id: 'user-a', title: 'Concluído' }
+];
+const updates = [];
+const docContext = {
+  cloudSession: { user: { id: 'user-a' } },
+  validSession: async () => ({ user: { id: 'user-a' } }),
+  activeCampaign: () => ({ dbId: 'portal-a' }),
+  cloudFetch: async (path, options = {}) => {
+    if (options.method === 'PATCH') { updates.push(JSON.parse(options.body)); return { ok: true }; }
+    return { ok: true, json: async () => documents.map(doc => ({ ...doc })) };
+  },
+  cloudDocuments: [], state: { customCampaign: { missions: [{ id: 'old-topic' }] } },
+  window: { _activeProcessingDocs: new Set() },
+  standardizeDocumentTitle: value => value, normalizeText: value => value.toLowerCase(),
+  isEditalDocumentOrTitle: value => value.document_type === 'edital',
+  renderUserDocuments() {}, console,
+  $: () => ({ textContent: '' }), databaseSetupMessage: error => error.message
+};
+vm.createContext(docContext);
+const docStart = html.indexOf('async function loadCloudDocuments()');
+vm.runInContext(html.slice(docStart, html.indexOf('async function loadEssays()', docStart)), docContext);
+await docContext.loadCloudDocuments();
+assert.deepEqual(Array.from(docContext.cloudDocuments, doc => doc.processing_status), ['pending', 'processing', 'ready']);
+assert.deepEqual(updates, [], 'tópicos antigos não comprovam conclusão do processamento atual');
+console.log('OK r174: retomada após fechar aba, isolamento usuário/portal/reset, expiração, quota, descarte e respostas sem pontuação duplicada.');
+console.log('OK r174: filtros sem catálogo duplicado; gráficos e catálogo após paint; jobs antigos e abas inativas cancelados.');
+console.log('OK r174: edital pendente/processando mantém o status real mesmo quando o portal já possui missões antigas.');
+
+// Cronometrado: relógio de parede, namespace próprio e formato completo para retomar.
+const { timedRemainingSeconds } = storeContext.window.JornadaQuestionSessions;
+const timedScope = {...scope, kind: 'timed'};
+const timedBattle = {
+  sessionId: 'timed-session-1', questions: [{...question}, {...question}],
+  current: 1, answers: [1, null], eliminated: [[0], []],
+  totalSeconds: 1200, startedAt: now - 45000, remainingSeconds: 1200,
+  scoringMode: 'standard', finished: false,
+};
+assert.equal(timedRemainingSeconds(timedBattle, now), 1155);
+assert.equal(timedRemainingSeconds(timedBattle, now + 1200000), 0);
+assert.equal(timedRemainingSeconds({...timedBattle, startedAt: undefined}, now), 0);
+assert.equal(first.save(timedScope, {battle: timedBattle}), 'local');
+assert.equal(first.read(scope), null, 'simulado e treino usam chaves distintas');
+const afterClose = createStore({storage, fallbackStorage: memoryStorage(), now: () => now + 30000});
+const resumed = afterClose.read(timedScope);
