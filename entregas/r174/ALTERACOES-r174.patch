diff --git a/.github/workflows/browser-smoke.yml b/.github/workflows/browser-smoke.yml
new file mode 100644
index 0000000..a3e8a3f
--- /dev/null
+++ b/.github/workflows/browser-smoke.yml
@@ -0,0 +1,26 @@
+name: Homologar navegador (manual)
+on:
+  workflow_dispatch:
+permissions:
+  contents: read
+jobs:
+  browser:
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: '24'
+          cache: npm
+      - run: npm ci --ignore-scripts
+      - run: npx playwright install --with-deps chromium
+      - run: npm run test:browser
+        env:
+          BROWSER_SMOKE_ARTIFACTS: browser-artifacts
+      - uses: actions/upload-artifact@v4
+        if: failure()
+        with:
+          name: browser-failures
+          path: browser-artifacts/
+          if-no-files-found: ignore
