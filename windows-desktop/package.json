{
  "name": "jornada-do-cacador-desktop",
  "version": "1.0.0",
  "description": "Aplicativo Windows da plataforma Jornada do Caçador",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:windows": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "br.com.jornadadocacador.app",
    "productName": "Jornada do Caçador",
    "artifactName": "Jornada-do-Cacador-Setup-${version}.${ext}",
    "directories": { "output": "release" },
    "files": ["main.js", "package.json"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Jornada do Caçador"
    }
  }
}